// engine.src — furet's engine abstraction + the agent-facing JSON envelope.
//
// Every command produces the SAME Result shape regardless of which engine ran
// it. That uniform envelope is the whole point: an agent can flip --light /
// --heavy and keep parsing identical output. The light engine is the custom
// fetch+DOM+JS stack (this file + dom/css + the QuickJS bridge). The heavy
// engine is a seam for a future chrome-in-xvfb backend; today it returns a
// clean "unimplemented" so callers can detect and fall back.

type Page struct { ok bool  status int  url string  final_url string  ctype string  body string  err string }

// ---- engine dispatch ----

func light_fetch(url) (p) {
  status, raw, err := http_get(url)
  body := to_utf8(raw)
  ctype := ""
  low := to_lower(body)
  if contains(low, "<html") || contains(low, "<!doctype html") { ctype = "text/html" }
  p = Page{ len(err) == 0, status, url, url, ctype, body, err }
}

// ---- heavy engine: real Chrome via CDP (launch locally, or attach to any
// CDP endpoint via FURET_CDP_URL / FURET_CDP_HTTP — the production stealth path:
// point furet at a real desktop Chrome or a remote browser). ----

// http10_get: a Content-Length-aware HTTP/1.1 GET over dial(). machin's http_get
// keeps the connection alive and HANGS on Chrome/Edge's DevTools HTTP endpoint
// (it never closes on its own, and its DevTools server rejects HTTP/1.0). We read
// the headers, honour Content-Length, and stop — no wait for a close that never
// comes.
func idx_from(s, needle, from) (pos) {
  pos = -1
  if from >= len(s) { return }
  sub := substr(s, from, len(s))
  p := index(sub, needle)
  if p < 0 { return }
  pos = p + from
}
func parse_clen(headers) (n) {
  n = -1
  low := to_lower(headers)
  p := index(low, "content-length:")
  if p < 0 { return }
  st := p + 15
  e := idx_from(low, "\r\n", st)
  if e < 0 { e = len(low) }
  n = parse_int(trim(substr(headers, st, e)))
}
func http10_get(host, port, path) (ok, body) {
  ok = false
  body = ""
  fd := dial(host, port)
  if fd <= 0 { return }
  req := "GET " + path + " HTTP/1.1\r\nHost: " + host + ":" + str(port) + "\r\nAccept: */*\r\nConnection: close\r\n\r\n"
  if write(fd, req) <= 0 { close(fd)  return }
  buf := bytes("")
  term := bytes("\r\n\r\n")
  k := 0
  for bytes_index(buf, term, 0) < 0 && k < 100000 {
    chunk := read_bytes(fd)
    if len(chunk) == 0 { break }
    buf = bytes_concat(buf, chunk)
    k = k + 1
  }
  hp := bytes_index(buf, term, 0)
  if hp < 0 { close(fd)  return }
  headers := bytes_str(bytes_sub(buf, 0, hp))
  clen := parse_clen(headers)
  bstart := hp + 4
  if clen < 0 {
    kk := 0
    for kk < 100000 { chunk := read_bytes(fd)  if len(chunk) == 0 { break }  buf = bytes_concat(buf, chunk)  kk = kk + 1 }
    close(fd)
    body = bytes_str(bytes_sub(buf, bstart, len(buf)))
    ok = true
    return
  }
  kk := 0
  for len(buf) < bstart + clen && kk < 100000 {
    chunk := read_bytes(fd)
    if len(chunk) == 0 { break }
    buf = bytes_concat(buf, chunk)
    kk = kk + 1
  }
  close(fd)
  body = bytes_str(bytes_sub(buf, bstart, bstart + clen))
  ok = true
}

// split "http://host:port" into (host, port); defaults port 9222.
func parse_http_base(base) (host, port) {
  host = "127.0.0.1"
  port = 9222
  rest := base
  if has_prefix(rest, "http://") { rest = substr(rest, 7, len(rest)) }
  slash := index(rest, "/")
  if slash >= 0 { rest = substr(rest, 0, slash) }
  colon := index(rest, ":")
  if colon >= 0 { host = substr(rest, 0, colon)  port = parse_int(substr(rest, colon+1, len(rest))) } else { host = rest }
}

// dedupe + screenshot config (set from CLI flags in main).
var g_dedupe = true
var g_shot = ""

// best-effort dedupe: drop items whose JSON hash was already seen.
func js_dd_def() (s) {
  s = "var __dd=function(a){if(!Array.isArray(a))return a;var s={},o=[],i;for(i=0;i<a.length;i++){var x=a[i];var k=(x&&typeof x===\"object\")?JSON.stringify(x):String(x);if(!s[k]){s[k]=1;o.push(x);}}return o;};"
}
func dd_flag() (d) { d = "false"  if g_dedupe { d = "true" } }

// wrap a LIGHT (synchronous, QuickJS) extractor: dedupe, then JSON.stringify
// {count,items} (QuickJS String()-of-object is useless, so stringify explicitly).
func wrap_light(js) (w) {
  w = "(function(){" + js_dd_def() +
      "var r = (" + js + ");" +
      "if(" + dd_flag() + "){ r = __dd(r); }" +
      "return JSON.stringify(Array.isArray(r)?{count:r.length,items:r}:{count:(r==null?0:1),items:r});" +
      "})()"
}
// wrap a HEAVY (async, real browser) extractor: await, dedupe, return the object
// (CDP returnByValue serializes it).
func wrap_heavy(js) (w) {
  w = "(async()=>{" + js_dd_def() +
      "var r = await (" + js + ");" +
      "if(" + dd_flag() + "){ r = __dd(r); }" +
      "return Array.isArray(r)?{count:r.length,items:r}:{count:(r==null?0:1),items:r};" +
      "})()"
}

// capture a PNG of the current heavy page to `path` (opt-in proof). base64_decode
// truncates at NUL, so we hand the base64 to the shell's `base64 -d`.
func capture_screenshot(path) (ok) {
  ok = false
  res := cdp_call("Page.captureScreenshot", "{\"format\":\"png\",\"captureBeyondViewport\":false}")
  if len(res) == 0 { return }
  data, e := json_get(res, ".result.data")
  if len(e) > 0 || len(data) == 0 { return }
  if has_prefix(data, "\"") { data = substr(data, 1, len(data)-1) }
  tmp := path + ".b64"
  write_file_bytes(tmp, bytes(data))
  system("base64 -d " + tmp + " > " + path + " && rm -f " + tmp)
  ok = true
}

func find_ws_url(js) (url) {
  url = ""
  key := "\"webSocketDebuggerUrl\""
  best := ""
  pos := 0
  k := 0
  for k < 100000 {
    p := idx_from(js, key, pos)
    if p < 0 { k = 100000 } else {
      o := idx_from(js, "\"", p + len(key))
      if o < 0 { k = 100000 } else {
        e := idx_from(js, "\"", o + 1)
        if e < 0 { k = 100000 } else {
          u := substr(js, o + 1, e)
          if len(best) == 0 { best = u }
          if contains(u, "/devtools/page/") { url = u  return }
          pos = e + 1
        }
      }
    }
    k = k + 1
  }
  url = best
}

func heavy_launch() (base) {
  base = ""
  dir := "/tmp/furet-chrome"
  system("rm -rf " + dir + " && mkdir -p " + dir)
  pre := ""
  if len(env("DISPLAY")) == 0 { pre = "xvfb-run -a --server-args=\"-screen 0 1920x1080x24\" " }
  cmd := "setsid " + pre + "google-chrome --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1" +
         " --remote-allow-origins=* --user-data-dir=" + dir +
         " --no-first-run --no-default-browser-check --disable-blink-features=AutomationControlled" +
         " --lang=fr-FR --window-size=1600,1000 about:blank </dev/null >/tmp/furet-chrome.log 2>&1 &"
  system(cmd)
  b := "http://127.0.0.1:9222"
  k := 0
  for k < 40 {
    ok, _ := http10_get("127.0.0.1", 9222, "/json/version")
    if ok { base = b  return }
    sleep(500)
    k = k + 1
  }
}

func heavy_ws_url() (url, errmsg) {
  url = ""
  errmsg = ""
  direct := env("FURET_CDP_URL")
  if len(direct) > 0 { url = direct  return }
  base := env("FURET_CDP_HTTP")
  if len(base) == 0 {
    base = heavy_launch()
    if len(base) == 0 { errmsg = "heavy: could not start Chrome (set FURET_CDP_URL to attach to a browser)"  return }
  }
  host, port := parse_http_base(base)
  gok, body := http10_get(host, port, "/json")
  if !gok { errmsg = "heavy: cannot reach CDP at " + base + "/json"  return }
  url = find_ws_url(body)
  if len(url) == 0 { errmsg = "heavy: no page target at " + base }
}

// heavy_run: connect CDP, navigate, run an (async) JS extractor, return its
// JSON value. settle_ms is the post-navigate wait before evaluating.
func heavy_run(url, js, settle_ms) (ok, value, errmsg) {
  ok = false
  value = ""
  errmsg = ""
  wsurl, e := heavy_ws_url()
  if len(e) > 0 { errmsg = e  return }
  if !ws_connect(wsurl) { errmsg = "heavy: cannot connect CDP websocket " + wsurl  return }
  cdp_call("Page.enable", "")
  cdp_call("Runtime.enable", "")
  cdp_call("Page.navigate", "{\"url\":" + jstr(url) + "}")
  sleep(settle_ms)
  v, ee := cdp_eval(js, true)
  if len(g_shot) > 0 { capture_screenshot(g_shot) }
  ws_close()
  if len(ee) > 0 { errmsg = ee  return }
  value = v
  ok = true
}

// kept for the light path's Page shape; heavy commands use heavy_run directly.
func heavy_fetch(url) (p) {
  p = Page{ false, 0, url, url, "", "", "engine 'heavy': use fetch/extract/eval/maps (they drive CDP), not the light Page path" }
}

// the Google Maps scraping recipe: dismiss consent, scroll the results feed
// until enough place cards load, then map each to {name,url}.
func maps_recipe() (js) {
  js = "(async()=>{" +
       "const sleep=ms=>new Promise(r=>setTimeout(r,ms));" +
       "await sleep(1500);" +
       "const cbtn=[...document.querySelectorAll('button,[role=\"button\"]')].find(b=>/tout accepter|accept all|j.accepte|agree/i.test(b.textContent||''));" +
       "if(cbtn){cbtn.click(); await sleep(2000);}" +
       "let last=0,stale=0;" +
       "for(let k=0;k<160 && stale<30;k++){" +
       "const cards=document.querySelectorAll('a.hfpxzc');" +
       "if(cards.length){ cards[cards.length-1].scrollIntoView({block:'end',behavior:'instant'}); }" +
       "const f=document.querySelector('[role=\"feed\"]'); if(f){ f.scrollTop=f.scrollHeight; if(k%7===6){ f.scrollTop=f.scrollHeight-1200; } }" +
       "await sleep(1000);" +
       "const done=/vous \u00eates arriv|end of the list|reached the end of|fin de la liste/i.test(document.body?document.body.innerText:'');" +
       "const n=document.querySelectorAll('a.hfpxzc').length; stale=(n===last)?stale+1:0; last=n;" +
       "if(done) break;}" +
       "return [...document.querySelectorAll('a.hfpxzc')].map(a=>({name:a.getAttribute('aria-label')||'',url:a.href}));" +
       "})()"
}

func cmd_maps(engine, query) (code) {
  murl := "https://www.google.com/maps/search/" + replace(query, " ", "+") + "?hl=fr"
  if engine != "heavy" {
    emit_err(engine, "maps", murl, 0, "maps requires --heavy (Google Maps is JS-rendered + anti-bot; needs a real browser)")
    code = 1
    return
  }
  ok, val, err := heavy_run(murl, wrap_heavy(maps_recipe()), 3000)
  if !ok { emit_err("heavy", "maps", murl, 0, err)  code = 1  return }
  emit("heavy", "maps", murl, 200, true, val, "")
  code = 0
}

func engine_fetch(engine, url) (p) {
  if engine == "heavy" { p = heavy_fetch(url) } else { p = light_fetch(url) }
}

func engine_known(engine) (b) { b = engine == "light" || engine == "heavy" }

// ---- JSON helpers (hand-rolled so `data` can hold raw JSON) ----

func jesc(s) (out) {
  out = replace(s, "\\", "\\\\")
  out = replace(out, "\"", "\\\"")
  out = replace(out, "\n", "\\n")
  out = replace(out, "\r", "\\r")
  out = replace(out, "\t", "\\t")
}
func jstr(s) (out) { out = "\"" + jesc(s) + "\"" }
func jbool(b) (out) { out = "false"  if b { out = "true" } }

// serialize the DOM arena to a compact JSON array for injection into JS.
func dom_to_json(d) (out) {
  parts := []string{}
  parts = append(parts, "[")
  i := 0
  for i < len(d.nodes) {
    if i > 0 { parts = append(parts, ",") }
    parts = append(parts, "{\"k\":" + str(d.nodes[i].kind) + ",\"t\":" + jstr(d.nodes[i].tag) + ",\"x\":" + jstr(d.nodes[i].text) + ",\"a\":[")
    j := 0
    for j < len(d.nodes[i].attrs) {
      if j > 0 { parts = append(parts, ",") }
      parts = append(parts, "[" + jstr(d.nodes[i].attrs[j].name) + "," + jstr(d.nodes[i].attrs[j].val) + "]")
      j = j + 1
    }
    parts = append(parts, "],\"c\":[")
    k := 0
    for k < len(d.nodes[i].kids) {
      if k > 0 { parts = append(parts, ",") }
      parts = append(parts, str(d.nodes[i].kids[k]))
      k = k + 1
    }
    parts = append(parts, "]}")
    i = i + 1
  }
  parts = append(parts, "]")
  out = join(parts, "")
}

// stand up a JS context with a real `document` over the fetched page + a `page` object.
func js_setup(e, d, url, status, body) {
  db_eval(e, "globalThis.__NODES = " + dom_to_json(d) + ";")
  db_eval(e, dom_shim_js())
  db_set(e, "url", url)
  db_set(e, "status", str(status))
  // title/text are lazy JS getters over the real document so huge pages do not
  // pay a full-document text pass unless the caller actually reads them.
  db_eval(e, "var page = { url: dom.get('url'), status:+dom.get('status')," +
             " get title(){ return document.title; }," +
             " get text(){ return document.body ? document.body.textContent : ''; } };")
}

// emit the envelope. `data` is already-formed JSON (object/array/null).
func emit(engine, cmd, url, status, ok, data, errmsg) {
  s := "{"
  s = s + "\"ok\":" + jbool(ok)
  s = s + ",\"engine\":" + jstr(engine)
  s = s + ",\"cmd\":" + jstr(cmd)
  s = s + ",\"url\":" + jstr(url)
  s = s + ",\"status\":" + str(status)
  s = s + ",\"data\":" + data
  s = s + ",\"error\":" + jstr(errmsg)
  s = s + "}"
  println(s)
}

func emit_err(engine, cmd, url, status, errmsg) {
  emit(engine, cmd, url, status, false, "null", errmsg)
}

// ---- url resolution (relative -> absolute) ----

func url_scheme_host(base) (scheme, host, ok) {
  scheme = ""
  host = ""
  ok = false
  p := index(base, "://")
  if p < 0 { return }
  scheme = substr(base, 0, p)
  rest := substr(base, p+3, len(base))
  slash := index(rest, "/")
  if slash < 0 { host = rest } else { host = substr(rest, 0, slash) }
  ok = true
}

func url_resolve(base, href) (out) {
  out = href
  if len(href) == 0 { return }
  if has_prefix(href, "http://") || has_prefix(href, "https://") { return }
  scheme, host, ok := url_scheme_host(base)
  if !ok { return }
  if has_prefix(href, "//") { out = scheme + ":" + href  return }
  if has_prefix(href, "/") { out = scheme + "://" + host + href  return }
  // relative to the base directory
  dir := base
  q := index(dir, "?")
  if q >= 0 { dir = substr(dir, 0, q) }
  cut := last_index(dir, "/")
  if cut > index(dir, "://")+2 { dir = substr(dir, 0, cut+1) } else { dir = scheme + "://" + host + "/" }
  out = dir + href
}

func last_index(s, sub) (pos) {
  pos = -1
  i := 0
  for i < len(s) {
    if i + len(sub) <= len(s) && substr(s, i, i+len(sub)) == sub { pos = i }
    i = i + 1
  }
}

// ---- commands (light engine; heavy short-circuits on p.err) ----

func cmd_fetch(engine, url) (code) {
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "fetch", url, p.status, p.err)  code = 1  return }
  d := parse_html(p.body)
  data := "{\"bytes\":" + str(len(p.body)) + ",\"content_type\":" + jstr(p.ctype) +
          ",\"title\":" + jstr(dom_title(d)) + "}"
  emit(engine, "fetch", url, p.status, true, data, "")
  code = 0
}

func cmd_html(engine, url) (code) {
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "html", url, p.status, p.err)  code = 1  return }
  emit(engine, "html", url, p.status, true, "{\"html\":" + jstr(p.body) + "}", "")
  code = 0
}

func cmd_text(engine, url, sel) (code) {
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "text", url, p.status, p.err)  code = 1  return }
  d := parse_html(p.body)
  if len(sel) == 0 {
    emit(engine, "text", url, p.status, true, "{\"text\":" + jstr(dom_text(d)) + "}", "")
    code = 0
    return
  }
  arr := "["
  first := true
  for _, i := range find_all(d, sel) {
    if !first { arr = arr + "," }
    arr = arr + jstr(node_text(d, i))
    first = false
  }
  arr = arr + "]"
  emit(engine, "text", url, p.status, true, "{\"selector\":" + jstr(sel) + ",\"matches\":" + arr + "}", "")
  code = 0
}

func cmd_links(engine, url) (code) {
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "links", url, p.status, p.err)  code = 1  return }
  d := parse_html(p.body)
  arr := "["
  first := true
  for _, i := range find_all(d, "a") {
    href := get_attr(d, i, "href")
    if len(href) == 0 { continue }
    if !first { arr = arr + "," }
    arr = arr + "{\"href\":" + jstr(href) +
          ",\"abs\":" + jstr(url_resolve(url, href)) +
          ",\"text\":" + jstr(node_text(d, i)) + "}"
    first = false
  }
  arr = arr + "]"
  emit(engine, "links", url, p.status, true, "{\"links\":" + arr + "}", "")
  code = 0
}

func cmd_attr(engine, url, sel, name) (code) {
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "attr", url, p.status, p.err)  code = 1  return }
  d := parse_html(p.body)
  arr := "["
  first := true
  for _, i := range find_all(d, sel) {
    if !has_attr(d, i, name) { continue }
    if !first { arr = arr + "," }
    arr = arr + jstr(get_attr(d, i, name))
    first = false
  }
  arr = arr + "]"
  emit(engine, "attr", url, p.status, true,
       "{\"selector\":" + jstr(sel) + ",\"name\":" + jstr(name) + ",\"values\":" + arr + "}", "")
  code = 0
}

func cmd_eval(engine, url, js) (code) {
  if engine == "heavy" {
    ok, val, err := heavy_run(url, "(" + js + ")", 2500)
    if !ok { emit_err("heavy", "eval", url, 0, err)  code = 1  return }
    emit("heavy", "eval", url, 200, true, "{\"result\":" + val + "}", "")
    code = 0
    return
  }
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "eval", url, p.status, p.err)  code = 1  return }
  d := parse_html(p.body)
  e := db_new()
  if e == 0 { emit_err(engine, "eval", url, p.status, "js engine failed to start")  code = 1  return }
  js_setup(e, d, url, p.status, p.body)
  res := db_eval(e, js)
  db_free(e)
  if has_prefix(res, "ERR: ") {
    emit_err(engine, "eval", url, p.status, substr(res, 5, len(res)))
    code = 1
    return
  }
  emit(engine, "eval", url, p.status, true, "{\"result\":" + jstr(res) + "}", "")
  code = 0
}

// extract: run a JS expression that returns an array/value over the real DOM,
// and emit it as structured JSON ({count, items}). This is the workhorse for
// scraping N records with document.querySelectorAll + element.textContent.
func cmd_extract(engine, url, js) (code) {
  if engine == "heavy" {
    ok, val, err := heavy_run(url, wrap_heavy(js), 2500)
    if !ok { emit_err("heavy", "extract", url, 0, err)  code = 1  return }
    emit("heavy", "extract", url, 200, true, val, "")
    code = 0
    return
  }
  p := engine_fetch(engine, url)
  if !p.ok { emit_err(engine, "extract", url, p.status, p.err)  code = 1  return }
  d := parse_html(p.body)
  e := db_new()
  if e == 0 { emit_err(engine, "extract", url, p.status, "js engine failed to start")  code = 1  return }
  js_setup(e, d, url, p.status, p.body)
  res := db_eval(e, wrap_light(js))
  db_free(e)
  if has_prefix(res, "ERR: ") {
    emit_err(engine, "extract", url, p.status, substr(res, 5, len(res)))
    code = 1
    return
  }
  emit(engine, "extract", url, p.status, true, res, "")
  code = 0
}
