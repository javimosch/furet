// main.src — furet CLI. A generalist scraping / browser-manipulation tool with a
// pluggable engine backend: --light (custom fetch+DOM+JS) today, --heavy
// (chrome-in-xvfb) as a wired seam for stealth. Output is always one JSON line.

func print_help() {
  println("furet — agent-first scraping & browser manipulation")
  println("")
  println("usage: furet [--light|--heavy|--engine E] <command> <url> [options]")
  println("")
  println("commands:")
  println("  fetch <url>                 status, byte count, content-type, title")
  println("  text  <url> [-s SELECTOR]   visible text (whole page, or per-match)")
  println("  links <url>                 all anchors: href, absolute url, text")
  println("  attr  <url> -s SEL -n NAME   an attribute's value for each match")
  println("  html  <url>                 raw response body")
  println("  eval  <url> --js 'EXPR'     run JS with a `page` object + document (light only)")
  println("  extract <url> --js 'EXPR'   run JS over the real DOM, emit {count,items} JSON")
  println("  feed  <url> --heavy -s SEL  scroll a JS-rendered list, collect items matching SEL")
  println("")
  println("options (extract/feed):")
  println("  --no-dedupe                 keep duplicates (best-effort dedupe is default)")
  println("  --screenshot PATH           heavy only: save a PNG proof of the page")
  println("  guide                       machine-readable capability catalog (JSON)")
  println("  help                        this text")
  println("")
  println("engine:")
  println("  --light        custom engine: fast, tiny, non-hostile JS sites (default)")
  println("  --heavy        chrome-in-xvfb backend for stealth (not yet implemented)")
  println("  --engine E     'light' or 'heavy'")
}

func print_guide() {
  s := "{\"tool\":\"furet\",\"version\":\"0.1.0\",\"summary\":\"agent-first scraping & browser manipulation with a pluggable engine backend\","
  s = s + "\"engines\":[{\"name\":\"light\",\"status\":\"ready\",\"desc\":\"custom fetch+DOM+JS (QuickJS); fast and tiny; for non-hostile JS sites\"},"
  s = s + "{\"name\":\"heavy\",\"status\":\"planned\",\"desc\":\"chrome-in-xvfb for stealth against anti-bot; same JSON envelope\"}],"
  s = s + "\"select_engine\":[\"--light\",\"--heavy\",\"--engine <name>\"],"
  s = s + "\"commands\":["
  s = s + "{\"name\":\"fetch\",\"args\":[\"url\"],\"data\":{\"bytes\":\"int\",\"content_type\":\"string\",\"title\":\"string\"}},"
  s = s + "{\"name\":\"text\",\"args\":[\"url\"],\"options\":{\"-s\":\"css selector\"},\"data\":{\"text|matches\":\"string|[]string\"}},"
  s = s + "{\"name\":\"links\",\"args\":[\"url\"],\"data\":{\"links\":\"[{href,abs,text}]\"}},"
  s = s + "{\"name\":\"attr\",\"args\":[\"url\"],\"options\":{\"-s\":\"selector\",\"-n\":\"attribute\"},\"data\":{\"values\":\"[]string\"}},"
  s = s + "{\"name\":\"html\",\"args\":[\"url\"],\"data\":{\"html\":\"string\"}},"
  s = s + "{\"name\":\"eval\",\"args\":[\"url\"],\"options\":{\"--js\":\"expression\"},\"data\":{\"result\":\"string\"},\"js_globals\":[\"page.url\",\"page.status\",\"page.title\",\"page.text\",\"page.html\",\"document.querySelector\",\"document.querySelectorAll\",\"element.textContent\",\"element.getAttribute\"]},"
  s = s + "{\"name\":\"extract\",\"args\":[\"url\"],\"options\":{\"--js\":\"expression returning an array/value over document\"},\"data\":{\"count\":\"int\",\"items\":\"any\"}},"
  s = s + "{\"name\":\"feed\",\"args\":[\"url\"],\"engine\":\"heavy\",\"options\":{\"-s\":\"repeating-item selector\",\"--feed\":\"scroll container selector\",\"--limit\":\"target count\"},\"data\":{\"count\":\"int\",\"items\":\"[{text,href}]\"},\"note\":\"generic infinite-scroll extractor; you supply url+selector; respect the site Terms\"}],"
  s = s + "\"defaults\":{\"dedupe\":\"on (hash items; --no-dedupe to disable)\",\"screenshot\":\"off (--screenshot PATH, heavy only)\"},"
  s = s + "\"envelope\":{\"ok\":\"bool\",\"engine\":\"string\",\"cmd\":\"string\",\"url\":\"string\",\"status\":\"int\",\"data\":\"object|null\",\"error\":\"string\"},"
  s = s + "\"css_support\":[\"tag\",\"*\",\"#id\",\".class\",\"[attr]\",\"compound\",\"descendant (space)\"],"
  s = s + "\"selector_note\":\"child >, siblings, attr-value, pseudo-classes are future slices\","
  s = s + "\"exit\":{\"0\":\"ok\",\"1\":\"command error\",\"2\":\"usage error\"}}"
  println(s)
}

func main() {
  fs := new_flags("furet")
  fs = flag_str(fs, "engine", "e", "light", "engine backend: light|heavy")
  fs = flag_bool(fs, "light", "", "use the light engine")
  fs = flag_bool(fs, "heavy", "", "use the heavy (chrome-in-xvfb) engine")
  fs = flag_str(fs, "selector", "s", "", "css selector")
  fs = flag_str(fs, "name", "n", "", "attribute name")
  fs = flag_str(fs, "js", "", "", "javascript expression for eval")
  fs = flag_bool(fs, "no-dedupe", "", "keep duplicate items (dedupe is on by default)")
  fs = flag_str(fs, "screenshot", "", "", "heavy: save a PNG proof of the page to this path")
  fs = flag_str(fs, "feed", "", "", "feed: scroll-container CSS selector (default: [role=feed] or the page)")
  fs = flag_int(fs, "limit", "l", "100", "feed: stop after about N items")
  fs = parse_flags(fs, args())
  if flag_on(fs, "no-dedupe") { g_dedupe = false }
  g_shot = flag_get(fs, "screenshot")

  rest := flag_args(fs)
  if len(rest) == 0 { print_help()  exit(2) }
  cmd := rest[0]

  if cmd == "help" { print_help()  exit(0) }
  if cmd == "guide" { print_guide()  exit(0) }

  engine := flag_get(fs, "engine")
  if flag_on(fs, "light") { engine = "light" }
  if flag_on(fs, "heavy") { engine = "heavy" }
  if !engine_known(engine) {
    emit_err(engine, cmd, "", 0, "unknown engine '" + engine + "' (use light|heavy)")
    exit(2)
  }

  if len(rest) < 2 {
    emit_err(engine, cmd, "", 0, "missing <url>")
    exit(2)
  }
  url := rest[1]
  sel := flag_get(fs, "selector")
  name := flag_get(fs, "name")
  js := flag_get(fs, "js")

  code := 0
  if cmd == "fetch" { code = cmd_fetch(engine, url) } else {
  if cmd == "text" { code = cmd_text(engine, url, sel) } else {
  if cmd == "links" { code = cmd_links(engine, url) } else {
  if cmd == "html" { code = cmd_html(engine, url) } else {
  if cmd == "attr" {
    if len(name) == 0 { emit_err(engine, "attr", url, 0, "attr needs -n <name>")  exit(2) }
    if len(sel) == 0 { emit_err(engine, "attr", url, 0, "attr needs -s <selector>")  exit(2) }
    code = cmd_attr(engine, url, sel, name)
  } else {
  if cmd == "eval" {
    if len(js) == 0 { emit_err(engine, "eval", url, 0, "eval needs --js <expr>")  exit(2) }
    code = cmd_eval(engine, url, js)
  } else {
  if cmd == "extract" {
    if len(js) == 0 { emit_err(engine, "extract", url, 0, "extract needs --js <expr returning an array>")  exit(2) }
    code = cmd_extract(engine, url, js)
  } else {
  if cmd == "feed" {
    code = cmd_feed(engine, url, flag_get(fs, "selector"), flag_get(fs, "feed"), flag_int_val(fs, "limit"))
  } else {
    emit_err(engine, cmd, url, 0, "unknown command '" + cmd + "' (see: furet help)")
    exit(2)
  }}}}}}}}
  exit(code)
}
